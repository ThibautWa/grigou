          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1d', 0), count(*) AS \"Connexions\" FROM audit_logs WHERE action = 'LOGIN_SUCCESS' AND $__timeFilter(created_at) GROUP BY 1 ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "grigou-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1d', 0), count(DISTINCT user_id) AS \"Utilisateurs distincts\" FROM audit_logs WHERE action = 'LOGIN_SUCCESS' AND $__timeFilter(created_at) GROUP BY 1 ORDER BY 1"
