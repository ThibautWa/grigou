    {
      "type": "row",
      "title": "Top (période sélectionnée)",
      "id": 13,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "bargauge",
      "title": "Pages les plus visitées",
      "id": 14,
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 8,
        "h": 10
      },
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "topk(15, sum by (uri) (count_over_time({container=\"grigou_nginx\", stream=\"stdout\"} |= \"\\\"host\\\":\" | json host, uri, status, user_agent | host=~\"(www\\\\.)?grigou\\\\.fr\" | uri !~ \"/_next/.*|/favicon.*|/api/.*|.*\\\\.(js|css|map|png|jpe?g|gif|svg|ico|webp|woff2?|txt|xml)$\" | uri !~ \".*\\\\.php.*|/wp-.*|/\\\\..*|.*/cgi-bin/.*\" | status < 400 | user_agent !~ \"(?i).*(bot|crawl|spider|slurp|curl|wget|python|go-http|httpclient|scan|zgrab|masscan|nmap|headless|java/|okhttp|libwww).*\" [$__range])))",
          "legendFormat": "{{uri}}",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "continuous-BlYlRd"
