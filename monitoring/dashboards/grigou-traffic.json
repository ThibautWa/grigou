{
  "uid": "grigou-traffic",
  "title": "Grigou – Trafic du site",
  "tags": [
    "grigou",
    "nginx",
    "loki"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "hide": 0,
        "current": {},
        "refresh": 1,
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Vue d'ensemble (période sélectionnée)",
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Visites",
      "id": 23,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "description": "Estimation du nombre de visites : un visiteur (IP + navigateur, hors robots) actif sur une tranche de 30 minutes compte pour une visite.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "count(sum by (remote_addr, user_agent) (count_over_time({container=\"grigou_nginx\", stream=\"stdout\"} |= \"\\\"host\\\":\" | json host, uri, status, user_agent, remote_addr | host=~\"(www\\\\.)?grigou\\\\.fr\" | label_format uri=`{{ regexReplaceAll \"\\\\?.*\" .uri \"\" }}` | uri !~ \"/_next/.*|/favicon.*|/api/.*|.*\\\\.(js|css|map|png|jpe?g|gif|svg|ico|webp|woff2?|txt|xml)$\" | uri !~ \".*\\\\.php.*|/wp-.*|/\\\\..*|.*/cgi-bin/.*\" | status >= 200 | status < 300 | user_agent != \"\" | user_agent != \"-\" | user_agent !~ \"(?i).*(bot|crawl|spider|slurp|curl|wget|python|go-http|httpclient|scan|zgrab|masscan|nmap|headless|java/|okhttp|libwww).*\" [30m])))",
          "queryType": "range",
          "step": "30m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "interval": "30m"
    },
    {
      "type": "stat",
      "title": "Visiteurs uniques (IP)",
      "id": 4,
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "description": "Adresses IP différentes ayant affiché au moins une page (hors robots).",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "count(sum by (remote_addr) (count_over_time({container=\"grigou_nginx\", stream=\"stdout\"} |= \"\\\"host\\\":\" | json host, uri, status, user_agent, remote_addr | host=~\"(www\\\\.)?grigou\\\\.fr\" | label_format uri=`{{ regexReplaceAll \"\\\\?.*\" .uri \"\" }}` | uri !~ \"/_next/.*|/favicon.*|/api/.*|.*\\\\.(js|css|map|png|jpe?g|gif|svg|ico|webp|woff2?|txt|xml)$\" | uri !~ \".*\\\\.php.*|/wp-.*|/\\\\..*|.*/cgi-bin/.*\" | status >= 200 | status < 300 | user_agent != \"\" | user_agent != \"-\" | user_agent !~ \"(?i).*(bot|crawl|spider|slurp|curl|wget|python|go-http|httpclient|scan|zgrab|masscan|nmap|headless|java/|okhttp|libwww).*\" [$__range])))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "type": "stat",
